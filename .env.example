# 開発環境の環境変数テンプレート
# 使い方: cp .env.example .env (このファイル自体は編集せずコミットする)
# - backend コンテナには env_file でこのファイルの全変数が注入される
# - mysql / minio / minio-init は docker-compose.yml 内の ${...} で必要な値だけ参照する

# --- DB(backend と mysql で共用) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=password
MYSQL_ROOT_PASSWORD=root

# --- 画像保存(開発: MinIO / 本番: S3) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=images

# --- メール送信(開発: Mailpit / 本番: SES) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@example.com

# --- 認証(フェーズ3) ---
# メール本文のリンクを組み立てるためのフロントエンドの入口 URL。
# 開発は Nuxt dev サーバー。本番は Spring Boot が SSG 出力を配信する同一オリジンの公開 URL になる。
APP_BASE_URL=http://localhost:3000
