# 開発環境の環境変数テンプレート
# 使い方: cp .env.example .env (このファイル自体は編集せずコミットする)
# - backend コンテナには env_file でこのファイルの全変数が注入される
# - mysql / minio / minio-init は docker-compose.yml 内の ${...} で必要な値だけ参照する

# --- DB(backend と mysql で共用) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=password
MYSQL_ROOT_PASSWORD=root

# --- 画像保存(開発: MinIO / 本番: S3) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=images

# --- メール送信(開発: Mailpit / 本番: SES) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@example.com
# smtp(Mailpit)か ses。開発では smtp のまま。この 2 つ以外の値は起動時に失敗する
# (config/AppProperties が enum で受け取るため。綴り間違いが黙って smtp になるのを防ぐ)。
# ses にすると AWS SDK の SesV2Client を作るので、リージョンと資格情報が無い環境では起動時に失敗する。
MAIL_TRANSPORT=smtp

# --- AWS 上でのみ使う変数(開発では設定しない。ECS のタスク定義が渡す) ---
# ここに書いてあるのは「本番で何が注入されるか」の一覧としての記載。
# CloudFormation テンプレート(cloudformation/app.yml)が実際の値を組み立てる。
#
# FLYWAY_ENABLED=false        ECS サービスは Flyway を走らせない(migrate 用 Run Task だけが true)
# FLYWAY_DB_USER=migrate      DDL 権限を持つユーザー(Run Task のみ)→ docs/adr/0005
# FLYWAY_DB_PASSWORD=...      同上(SSM SecureString から注入)
# SPRING_MAIN_WEB_APPLICATION_TYPE=none   migrate 用 Run Task。Web を立てずに起動して Flyway だけ実行する
# S3_BUCKET / IMAGE_CDN_DOMAIN            画像(フェーズ6)。開発は MinIO の値を上で設定している

# --- 認証(フェーズ3) ---
# メール本文のリンクを組み立てるためのフロントエンドの入口 URL。
# 開発は Nuxt dev サーバー。本番は Spring Boot が SSG 出力を配信する同一オリジンの公開 URL になる。
APP_BASE_URL=http://localhost:3000

# --- Google ログイン(フェーズ4) ---
# Google Cloud Console で OAuth 2.0 クライアント ID を作って貼る。取得手順 → docs/setup/google-oauth.md
# 承認済みのリダイレクト URI には http://localhost:3000/api/login/oauth2/code/google を登録すること。
# このダミーのままでもアプリは起動する(Google ログインだけが使えない)。
# 空文字にはしないこと。空文字は「値が設定されている」扱いになり application.yml の既定値が効かず、
# ClientRegistration を組み立てられずに起動が失敗する。
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
